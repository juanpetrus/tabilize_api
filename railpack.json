{
  "$schema": "https://schema.railpack.com",
  "packages": {
    "python": "3.11"
  },
  "steps": {
    "install": {
      "commands": [
        "...",
        "npx playwright install chromium",
        "python3 -m pip install --upgrade pip",
        "python3 -m pip install --extra-index-url https://download.pytorch.org/whl/cpu torch torchvision",
        "python3 -m pip install easyocr opencv-python-headless",
        "python3 -c \"import easyocr; easyocr.Reader(['en'], gpu=False, verbose=False)\""
      ]
    }
  },
  "deploy": {
    "aptPackages": [
      "libnspr4",
      "libnss3",
      "libasound2",
      "libatk1.0-0",
      "libatk-bridge2.0-0",
      "libcups2",
      "libdbus-1-3",
      "libdrm2",
      "libxkbcommon0",
      "libatspi2.0-0",
      "libxcomposite1",
      "libxdamage1",
      "libxfixes3",
      "libxrandr2",
      "libgbm1",
      "libpango-1.0-0",
      "libcairo2",
      "libxshmfence1",
      "fonts-liberation",
      "fonts-noto-color-emoji",
      "libgl1",
      "libglib2.0-0"
    ]
  }
}
